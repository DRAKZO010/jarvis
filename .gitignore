# --- secrets and local config ---
.env
.env.*
!.env.example

# --- personal, not for publishing ---
# These name the owner and their college, and this repository is public.
# They still work at runtime; they are just kept off git.
SOUL.md
USER.md

# --- python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# --- test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- runtime state (personal, regenerated by the app) ---
jarvis_tasks.json
jarvis_reminders.json
jarvis_context.json
jarvis_memory.json

# --- logs ---
logs/
*.log

