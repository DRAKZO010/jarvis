# JARVIS configuration
# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# LLM (Google Gemini) - powers free-form questions and command routing
# ---------------------------------------------------------------------------
# Without a key Jarvis still works: every pattern-matched command runs offline,
# and unmatched speech is simply not routed through a model.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# gemini-flash-latest tracks the newest fast model. Pin a version such as
# gemini-3.1-flash-lite-preview if you would rather it not move under you.
LLM_MODEL=gemini-flash-latest
# Gemini 3.x reasons before answering, and those thinking tokens come out of
# max_tokens. Lower values return an empty or cut-off reply.
LLM_MAX_TOKENS=800
# The free tier allows 20 requests per DAY, not per minute, and the budget is
# per project and per model rather than per conversation, so a separate chat
# window does not raise it. A command that matches the pattern table costs
# nothing, a question costs 1 request (it skips routing), and a phrased command
# costs 1 request (to pick the action). Repeat phrasings are cached in memory.
# A paid key is the only way to lift the cap.
#
# The cap is counted per model, so when one model has used its day JARVIS moves
# to the next one in this list instead of going quiet. Leave it unset for the
# built-in defaults, or name your own comma-separated chain. A model that
# returns 404 for this key is skipped and remembered for the session.
LLM_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# JARVIS counts its own requests and refuses to spend the last of the day's
# allowance on command routing, holding this many back for answering questions.
LLM_DAILY_LIMIT=20
LLM_ANSWER_RESERVE=3

# ---------------------------------------------------------------------------
# Text to speech
# ---------------------------------------------------------------------------
# Fish Audio is the only text-to-speech backend. There is no fallback: if it
# is unavailable or out of API credit, JARVIS stays silent rather than
# speaking in a voice you did not choose.
# API credit is billed separately from a Fish subscription, and the paid
# model returns HTTP 402 without it:
#   https://fish.audio/app/developers
# s2.1-pro-free needs no credit. Use s2.1-pro once you have topped up.
FISH_API_KEY=
FISH_VOICE_ID=
FISH_TTS_MODEL=s2.1-pro-free

# ---------------------------------------------------------------------------
# Speech recognition (Vosk, runs locally)
# ---------------------------------------------------------------------------
# Speech is always transcribed by the model in ./model (Vosk, offline). Set this
# to 1 to keep the microphone closed - useful on a headless box, or on a
# machine where another app owns the capture device. 0, false and an empty
# value all leave the microphone enabled.
JARVIS_DISABLE_MIC=0

# Which name(s) wake the assistant. Comma-separated, so a rename never locks
# you out of the old one. Leave it blank to disable the wake word entirely,
# in which case every utterance is treated as a command.
JARVIS_WAKE_WORD=jarvis

# Which microphone to record from. Either a device index, or any part of a
# device name (case-insensitive), e.g. "Realtek" or "Hands-Free".
# Leave it blank to let Jarvis decide: the Windows default is used if it
# carries any signal, and if it is silent the loudest input wins. That
# matters on machines with several headsets and virtual audio devices.
# List what is available:
#   python -c "import sounddevice as sd; print(sd.query_devices())"
JARVIS_INPUT_DEVICE=

# Which speakers to play replies on. Either a device index, or any part of a
# device name (case-insensitive), e.g. "Stone 358" or "Headset".
# Leave it blank to let Jarvis decide: a connected headset or pair of earbuds
# is preferred, and the Windows default (the built-in speakers) otherwise.
# A device is only used if it also opens successfully, because Windows keeps
# every Bluetooth headset you have ever paired in the device list, and picking
# one that nobody is wearing sounds exactly like a broken speaker.
# The choice is re-checked every few seconds, so earbuds connected partway
# through a conversation are picked up without a restart.
JARVIS_OUTPUT_DEVICE=

# Overrides the speech gate that Jarvis measures at startup, e.g. 0.008.
# Normally unset, and normally wrong to set: the calibrator places the gate
# between the room noise and the voice using a low percentile of the level
# distribution, which a fixed number cannot do. The measured values are in
# /health under noise_floor, vad_threshold and speaking_threshold.
JARVIS_VAD_THRESHOLD=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Used by the weather lookup when no city is given in the command
DEFAULT_CITY=London
