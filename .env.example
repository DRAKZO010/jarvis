# JARVIS configuration
# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# LLM (OpenRouter) - powers free-form questions and command parsing
# ---------------------------------------------------------------------------
# Without a key JARVIS still works; only conversational replies are disabled.
OPENROUTER_API_KEY=
LLM_MODEL=qwen/qwen-2.5-7b-instruct

# ---------------------------------------------------------------------------
# Text to speech
# ---------------------------------------------------------------------------
# Backends are tried in order and the first that works is used:
#   fish-audio  (cloud, best quality, needs credits)
#   edge-tts    (cloud, free, good quality)
#   sapi        (built into Windows, always available, offline)
# A backend that fails is disabled for the rest of the session, so a
# provider without credits only costs one failed call.
FISH_API_KEY=
FISH_VOICE_ID=
FISH_TTS_MODEL=s2.1-pro

# Any Edge TTS voice name, e.g. en-GB-RyanNeural, en-US-AriaNeural
EDGE_TTS_VOICE=en-GB-RyanNeural

# Words per minute for the Windows SAPI fallback (-10 to 10)
SAPI_RATE=0

# ---------------------------------------------------------------------------
# Speech recognition (Vosk, runs locally)
# ---------------------------------------------------------------------------
# Speech is always transcribed by the model in ./model (Vosk, offline). Set this
# to 1 to keep the microphone closed - useful on a headless box, or on a
# machine where another app owns the capture device. 0, false and an empty
# value all leave the microphone enabled.
JARVIS_DISABLE_MIC=0

# Which microphone to record from. Either a device index, or any part of a
# device name (case-insensitive), e.g. "Realtek" or "Hands-Free".
# Leave it blank to let JARVIS decide: the Windows default is used if it
# carries any signal, and if it is silent the loudest input wins. That
# matters on machines with several headsets and virtual audio devices.
# List what is available:
#   python -c "import sounddevice as sd; print(sd.query_devices())"
JARVIS_INPUT_DEVICE=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Used by the weather lookup when no city is given in the command
DEFAULT_CITY=London
